# Copy to .env and fill in. Never commit .env.
PLAYHQ_API_KEY=
# Association that owns the API key (from PlayHQ's key email).
PLAYHQ_ORG_ID=
# Sport tenant sent as x-phq-tenant ("bv" for Basketball Victoria). Blank = auto-detect.
PLAYHQ_TENANT=bv
# Club whose teams we track. Its seasons include competitions run by other associations.
PLAYHQ_CLUB_ID=
